# Generates sourceCode/shaders_embedded.h from resources/shaders/*.
#
# Run manually when a shader changes (the result is checked in, so that neither
# the plugin build nor its consumers need Python, Qt's resource compiler or any
# other tool):
#
#     cmake -DSHADER_DIR=<...>/resources/shaders -DOUT=<...>/sourceCode/shaders_embedded.h -P embed_shaders.cmake
#
# "#include \"common.glsl\"" is expanded here rather than at run time, which
# removes the last piece of file loading from the renderer.

if(NOT SHADER_DIR)
    message(FATAL_ERROR "SHADER_DIR is not set")
endif()
if(NOT OUT)
    message(FATAL_ERROR "OUT is not set")
endif()

file(READ "${SHADER_DIR}/common.glsl" COMMON_GLSL)

set(SHADER_LIST
    "kSceneVert:scene.vert"
    "kSceneFrag:scene.frag"
    "kDepthVert:depth.vert"
    "kDepthFrag:depth.frag"
    "kDepthOmniVert:depth_omni.vert"
    "kDepthOmniFrag:depth_omni.frag"
    "kFullscreenVert:fullscreen.vert"
    "kTonemapFrag:tonemap.frag"
    "kMarkerVert:marker.vert"
    "kMarkerFrag:marker.frag"
    "kColorCodeVert:colorcode.vert"
    "kColorCodeFrag:colorcode.frag"
    "kPointsVert:points.vert"
    "kPointsFrag:points.frag"
    "kVoxelsVert:voxels.vert"
    "kVoxelsFrag:voxels.frag"
)

set(HEADER "// Generated by tools/embed_shaders.cmake from resources/shaders/*.\n")
string(APPEND HEADER "// Do not edit; run the generator instead.\n\n")
string(APPEND HEADER "#pragma once\n\n")
string(APPEND HEADER "namespace modern\n{\nnamespace shaders\n{\n\n")

foreach(ENTRY IN LISTS SHADER_LIST)
    string(REPLACE ":" ";" PARTS "${ENTRY}")
    list(GET PARTS 0 SYMBOL)
    list(GET PARTS 1 FILENAME)

    file(READ "${SHADER_DIR}/${FILENAME}" TEXT)
    string(REPLACE "#include \"common.glsl\"" "${COMMON_GLSL}" TEXT "${TEXT}")

    string(APPEND HEADER "inline const char* const ${SYMBOL} = R\"GLSL(${TEXT})GLSL\";\n\n")
endforeach()

string(APPEND HEADER "} // namespace shaders\n} // namespace modern\n")

file(WRITE "${OUT}" "${HEADER}")
message(STATUS "wrote ${OUT}")
